{
  "name": "fastapi-next-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "api:openapi": "node scripts/run-python.mjs apps/backend/scripts/export_openapi.py",
    "api:generate": "pnpm api:openapi && pnpm --filter next-frontend api:generate",
    "api:check": "pnpm api:generate && git diff --exit-code -- apps/frontend/src/api/generated/openapi.json apps/frontend/src/api/generated/schema.ts",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "2.3.3"
  }
}
